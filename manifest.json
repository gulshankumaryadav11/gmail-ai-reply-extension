{
  "manifest_version": 3,

  "name": "AI Gmail Reply Assistant",

  "version": "1.0",

  "description":
    "Generate AI-powered email replies directly inside Gmail.",

  "permissions": [
    "activeTab",
    "storage"
  ],

  "host_permissions": [

    "https://mail.google.com/*",

    "https://email-writer-sb-u1wg.onrender.com/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],

      "js": [
        "content.js"
      ],

      "run_at":
        "document_idle"
    }
  ],

  "action": {

    "default_popup":
      "popup.html"
  }
}
